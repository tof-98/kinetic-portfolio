---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} />
  </head>
  <body>
    <a href="#top" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import '../scripts/layout';
    </script>
  </body>
</html>
