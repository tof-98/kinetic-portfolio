---
import { TICK } from '../data/portfolio';
import { SITE } from '../data/site';
const seg = TICK.map((t) => `${t}<i>✦</i>`).join('');
---

<header class="hero">
  <div class="wrap">
    <div class="eye">
      <span class="b dot-centered">●</span>
      <span>{SITE.name}</span>
      <span>·</span>
      <span>Hall in Tirol, AT</span>
      <span>·</span>
      <span>Open to remote</span>
    </div>
  </div>
  <h1 class="mega">
    <span class="l"><span>Full-</span></span>
    <span class="l"><span>Stack</span></span>
    <span class="l"
      ><span class="word" aria-label="Developer"
        >{
          [...'Developer'].map((ch, i) => (
            <span class="dch" style={`--i:${i}`} aria-hidden="true">
              {ch}
            </span>
          ))
        }</span
      ></span
    >
  </h1>
  <div class="wrap">
    <div class="hero-sub">
      <p>
        Production web apps with <b>Java, Spring &amp; React</b> — engineered to ship,
        scale, and stay secure. Currently shipping full-stack at <b
          >LITTERA Software &amp; Consulting</b
        >.
      </p>
      <div class="cta-row">
        <a class="btn btn-solid" href="#work"
          >View work <span class="ar">↗</span></a
        >
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
  <div class="ticker">
    <div class="track" set:html={`<span>${seg}</span><span>${seg}</span>`} />
  </div>
</header>
