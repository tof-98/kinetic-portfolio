---
import { Image, getImage } from 'astro:assets';
import { MOMENTS } from '../data/portfolio';
import { SITE } from '../data/site';

const thumbs = await Promise.all(
  MOMENTS.map((m) => getImage({ src: m.image, width: 240 })),
);
const stripData = MOMENTS.map((m, i) => ({ t: m.title, src: thumbs[i].src }));
---

<section id="about" data-screen-label="About">
  <div class="wrap">
    <div class="shead rv">
      <span class="num">01</span>
      <span class="nm">About — two modes</span>
      <span class="rule"></span>
      <span class="meta">the human / the engineer</span>
    </div>
    <div class="modes">
      <!-- THE HUMAN -->
      <div class="mode human rv">
        <div class="tag">
          <b>A</b>The human<span class="ln"></span>how I think
        </div>
        <h3>Clarity over<br />cleverness</h3>
        <p class="intro">
          I turn complex problems into clear, elegant systems. I care about the
          craft — not just shipping fast.
        </p>
        <div class="traits">
          <div class="trait">
            <span class="tn">DRIVE</span>
            <div>
              <div class="tt">What drives me</div>
              <div class="td">
                Turning messy problems into clean, secure systems that keep
                working long after I ship them.
              </div>
            </div>
          </div>
          <div class="trait">
            <span class="tn">METHOD</span>
            <div>
              <div class="tt">How I work</div>
              <div class="td">
                Calm, consistent, security-first. Solid beats
                clever-but-fragile, every time.
              </div>
            </div>
          </div>
          <div class="trait">
            <span class="tn">OFFLINE</span>
            <div>
              <div class="tt">Away from the keyboard</div>
              <div class="td">
                Training, cooking, and tinkering with self-hosted side projects
                — curiosity doesn't clock out.
              </div>
            </div>
          </div>
        </div>
        <div class="studio">
          <div class="st-head">
            <span class="st-kicker">A moment in my day</span>
          </div>
          <div
            class="spot-stage"
            id="momentStage"
            data-moments={JSON.stringify(stripData)}
          >
            {
              MOMENTS.map((m) => (
                <article class="spot-frame">
                  <div class="kb">
                    <Image
                      src={m.image}
                      alt={m.title}
                      width={800}
                      height={600}
                      loading="lazy"
                      style={`object-position: ${m.objectPosition};`}
                    />
                  </div>
                </article>
              ))
            }
            <div class="spot-cap">
              <span class="num" id="stIx">01<b> / 0{MOMENTS.length}</b></span
              ><div class="ttl"><span id="stTtl">{MOMENTS[0].title}</span></div>
            </div>
          </div>
          <div class="spot-strip" id="momentStrip"></div>
        </div>
      </div>

      <!-- THE ENGINEER -->
      <div class="mode eng rv" style="transition-delay:.08s">
        <div class="tag">
          <b>B</b>The engineer<span class="ln"></span>why I'm a fit
        </div>
        <h3>Production-tested,<br />ready now</h3>
        <p class="intro">
          <b>2.5+ years</b> shipping production features at <b
            >LITTERA Software &amp; Consulting</b
          > — live for real customers, used daily across Austria &amp; Germany.
        </p>
        <div class="bignums">
          <div class="bn">
            <div class="v" data-count="2.5" data-suffix="+">0</div><div class="k">
              years live
            </div>
          </div>
          <div class="bn">
            <div class="v" data-count="50" data-suffix="+">0</div><div
              class="k"
            >
              features
            </div>
          </div>
          <div class="bn">
            <div class="v" data-count="3">0</div><div class="k">languages</div>
          </div>
        </div>
        <div class="erow">
          <span class="k">Education</span>
          <span class="v"
            >B.Sc. Computer Science<small>EQF 6 · Austria-recognised</small
            ></span
          >
        </div>
        <div class="erow">
          <span class="k">Eligibility</span>
          <span class="v"
            ><span class="ac">RWR – Karte plus</span><small
              >full labour-market access</small
            ></span
          >
        </div>
        <div class="erow">
          <span class="k">Start</span>
          <span class="v"
            >{SITE.availability.short}<small>{SITE.availability.detail}</small
            ></span
          >
        </div>
        <div class="certled">
          <div class="cl-cap">
            <b>✦</b> Certifications<span class="ln"></span>verified · 04
          </div>
          <a
            class="clrow"
            href="https://coursera.org/verify/professional-cert/DYH6I7G6W8EK"
            target="_blank"
            rel="noopener"
          >
            <span class="cl-ghost" aria-hidden="true">AI</span>
            <span class="cl-tok">AI</span>
            <div class="cl-name">Google AI Professional Certificate</div>
            <span class="cl-org"
              >Coursera · Jun 2026 <span class="vf">✓</span></span
            >
          </a>
          <div class="clrow">
            <span class="cl-ghost" aria-hidden="true">GOV</span>
            <span class="cl-tok">GOV</span>
            <div class="cl-name">AI Fundamentals &amp; Compliance</div>
            <span class="cl-org"
              >Mindlane · Feb 2026 <span class="vf">✓</span></span
            >
          </div>
          <a
            class="clrow"
            href="https://coursera.org/verify/professional-cert/TTF3V205LK39"
            target="_blank"
            rel="noopener"
          >
            <span class="cl-ghost" aria-hidden="true">SEC</span>
            <span class="cl-tok">SEC</span>
            <div class="cl-name">Google Cybersecurity</div>
            <span class="cl-org"
              >Coursera · Dec 2025 <span class="vf">✓</span></span
            >
          </a>
          <a
            class="clrow"
            href="https://coursera.org/verify/specialization/KKQMEVRVR6LQ"
            target="_blank"
            rel="noopener"
          >
            <span class="cl-ghost" aria-hidden="true">OOP</span>
            <span class="cl-tok">OOP</span>
            <div class="cl-name">OOP Java: Data Structures &amp; Beyond</div>
            <span class="cl-org"
              >Coursera · Nov 2023 <span class="vf">✓</span></span
            >
          </a>
        </div>
        <div class="chips">
          <span class="chip lang"><b>AR</b> Native</span>
          <span class="chip lang"><b>DE</b> C1</span>
          <span class="chip lang"><b>EN</b> B2</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/about';
</script>
