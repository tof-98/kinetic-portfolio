---
import { SITE } from '../data/site';

interface Props {
  title?: string;
}
const { title = SITE.seo.title } = Astro.props;
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base);

const og = SITE.seo.ogImage;
const ogImageUrl = og && new URL(og.path, base);
// Facebook and Instagram switch to a full-width banner at 600px; below that
// they render a compact card with a small thumbnail. Twitter's card types map
// onto the same split, so derive it from the width rather than hardcoding it.
const twitterCard = og && og.width >= 600 ? 'summary_large_image' : 'summary';
---

<meta charset="UTF-8" />
<link rel="icon" type="image/svg+xml" href="/th-ascendant-favicon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={SITE.seo.description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={SITE.seo.title} />
<meta property="og:description" content={SITE.seo.ogDescription} />
<meta property="og:url" content={canonical} />
{
  og && ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:type" content={og.type} />
      <meta property="og:image:width" content={String(og.width)} />
      <meta property="og:image:height" content={String(og.height)} />
      <meta property="og:image:alt" content={og.alt} />
    </>
  )
}
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={SITE.seo.title} />
<meta name="twitter:description" content={SITE.seo.ogDescription} />
{
  og && ogImageUrl && (
    <>
      <meta name="twitter:image" content={ogImageUrl} />
      <meta name="twitter:image:alt" content={og.alt} />
    </>
  )
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>
<script is:inline>
  // Paired with the THEME storage key in src/lib/constants.ts — keep literal:
  // this must run before first paint, so it cannot import from the module graph.
  if (localStorage.getItem('kinetic-theme') === 'light')
    document.documentElement.dataset.theme = 'light';
</script>
