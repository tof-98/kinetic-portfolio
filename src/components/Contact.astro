---
import { SITE } from '../data/site';
---

<section id="contact" class="contact" data-screen-label="Contact">
  <div class="wrap">
    <div class="shead rv">
      <span class="num">05</span>
      <span class="nm">Contact</span>
      <span class="rule"></span>
      <span class="meta">inbox open</span>
    </div>
    <h2 class="rv" id="contact-label">
      Let's build<br />something <span class="ac gleam">great.</span>
    </h2>
    <p class="lead rv">
      I'm open to new roles and interesting projects. Whether you have something
      in mind or just want to say hello — my inbox is always open.
    </p>
    <div class="c-actions rv">
      <button class="btn btn-solid" type="button" data-hello
        >Say hello <span class="ar">↗</span></button
      >
      <a class="mail" href={SITE.linkedin} target="_blank" rel="noopener"
        >LinkedIn ↗</a
      >
      <a class="mail" href={SITE.github} target="_blank" rel="noopener"
        >GitHub ↗</a
      >
    </div>
  </div>
</section>
