---
import { SKILLS } from '../data/portfolio';

const TIER_NAME: Record<number, string> = {
  3: 'core',
  2: 'proficient',
  1: 'familiar',
};
const lastIx = String(SKILLS.length).padStart(2, '0');
const HUES = ['h-1', 'h-2', 'h-3', 'h-4'];
---

<section id="stack" data-screen-label="Stack">
  <div class="wrap">
    <div class="shead rv">
      <span class="num">03</span>
      <span class="nm">Stack</span>
      <span class="rule"></span>
      <span class="meta">core / proficient / familiar</span>
    </div>

    <div class="dp-wrap rv" id="stackGrid">
      {
        SKILLS.map((s, i) => {
          const present = ([3, 2, 1] as const).filter((t) =>
            s.items.some(([, tt]) => tt === t),
          );
          const coreN = s.items.filter(([, t]) => t === 3).length;
          const tally = coreN
            ? `${s.items.length} skills · ${coreN} core`
            : `${s.items.length} skills`;
          return (
            <div class={`dp-lane ${HUES[i % HUES.length]}`}>
              <div class="dp-wash" aria-hidden="true" />
              <span class="dp-ghost" aria-hidden="true">
                {(s.ghost ?? s.name).slice(0, 5)}
              </span>
              <div class="dp-meta">
                <span class="dp-ix">
                  0{i + 1} / {lastIx}
                </span>
                <span class="dp-note">{s.note}</span>
                <h3 class="dp-dom">{s.name}</h3>
                <span class="dp-tick" />
                <span class="dp-count">{tally}</span>
              </div>
              <div class="dp-skills">
                {present.map((t, ri) => {
                  const arr = s.items
                    .filter(([, tt]) => tt === t)
                    .map(([n]) => n);
                  const hero = ri === 0;
                  const lineClass = hero ? 'core' : t === 2 ? 'prof' : 'fam';
                  return (
                    <div class="dp-row">
                      <span class="dp-cap">{TIER_NAME[t]}</span>
                      <div
                        class={`dp-line ${lineClass}`}
                        style={
                          hero
                            ? `--chars:${arr.reduce((s, n) => s + n.length, 0) + (arr.length - 1) * 3}`
                            : undefined
                        }
                      >
                        {hero
                          ? arr.map((n, wi) => (
                              <>
                                <span style={`--d:${wi}`}>{n}</span>
                                {wi < arr.length - 1 && (
                                  <span class="sep">/</span>
                                )}
                              </>
                            ))
                          : arr.map((n, ni) => (
                              <>
                                <span>{n}</span>
                                {ni < arr.length - 1 && (
                                  <span class="sd">·</span>
                                )}
                              </>
                            ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="stack-coda rv">
      <span class="coda-k">// How I learn</span>
      <p class="coda-q">
        Go deep until I <span class="ac">truly understand</span> a tool.
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/stack';
</script>
