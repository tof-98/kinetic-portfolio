---
import LogoAscendant from './LogoAscendant.astro';
import { SITE } from '../data/site';
---

<div class="bar" id="bar">
  <a class="id" href="#top"
    ><span class="sq"></span><LogoAscendant size={28} /></a
  >
  <nav>
    <a href="#about">About</a>
    <a href="#work">Work</a>
    <a href="#stack">Stack</a>
    <a href="#experience">Experience</a>
    <a href="#contact">Contact</a>
  </nav>
  <div class="bar-right">
    <span class="av"><span class="led"></span>{SITE.availability.short}</span>
    <a class="nav-cv" href="/cv.pdf" target="_blank" rel="noopener"
      >CV <span class="cv-ar">↓</span></a
    >
    <button
      class="theme-toggle"
      id="themeToggle"
      aria-label="Switch to light mode"
    >
      <span class="tt-thumb">
        <svg
          class="tt-moon"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg
          class="tt-sun"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"
          ></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </span>
    </button>
    <button
      class="burger"
      id="burger"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span></span><span></span>
    </button>
  </div>
</div>

<div class="navsheet" id="navSheet" aria-hidden="true">
  <nav>
    <a href="#about"><span class="mn-i">01</span>About</a>
    <a href="#work"><span class="mn-i">02</span>Work</a>
    <a href="#stack"><span class="mn-i">03</span>Stack</a>
    <a href="#experience"><span class="mn-i">04</span>Experience</a>
    <a href="#contact"><span class="mn-i">05</span>Contact</a>
  </nav>
  <div class="navsheet-foot">
    <a class="nav-cv ns-cv" href="/cv.pdf" target="_blank" rel="noopener"
      >CV <span class="cv-ar">↓</span></a
    >
    <span><span class="ac">●</span> {SITE.availability.long}</span>
    <span>Hall in Tirol, AT</span>
  </div>
</div>

<script>
  import '../scripts/nav';
</script>
