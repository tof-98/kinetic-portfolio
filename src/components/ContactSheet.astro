---
import { SITE } from '../data/site';
---

<div class="sheet-back" id="helloSheet" aria-hidden="true">
  <div class="card" role="dialog" aria-modal="true" aria-label="Get in touch">
    <form class="cf-form" id="helloForm" novalidate>
      <input
        type="text"
        name="_honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        style="position:absolute;opacity:0;height:0;width:0;pointer-events:none"
      />

      <aside class="cf-rail">
        <div class="cf-avatar" aria-hidden="true">T</div>
        <div class="cf-id">
          <span class="cf-name">{SITE.name}</span>
          <span class="cf-role">Developer</span>
        </div>

        <div class="cf-status">
          <span class="cf-dot" aria-hidden="true"></span>
          <span class="cf-status-txt">Replies within 24h</span>
          <span class="cf-clock"><b data-clock>—:—</b> · Hall in Tirol</span>
        </div>

        <div class="cf-social">
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </aside>

      <div class="cf-main">
        <header class="cf-head">
          <div>
            <h3 class="a-h">
              Let's talk <span class="dot">.</span>
            </h3>
            <span class="cf-text"
              >Whatever's on your mind - I'd love to hear it</span
            >
          </div>
          <button class="cf-x" type="button" data-close aria-label="Close">
            <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
              <path d="M1 1l10 10M11 1L1 11"></path>
            </svg>
          </button>
        </header>

        <div class="cf-body">
          <div class="a-row2">
            <div class="uf uf-float">
              <input
                id="cName"
                name="name"
                type="text"
                placeholder=" "
                required
              />
              <label for="cName">Name</label>
            </div>
            <div class="uf uf-float">
              <input
                id="cEmail"
                name="email"
                type="email"
                placeholder=" "
                required
              />
              <label for="cEmail">Email</label>
            </div>
          </div>
          <div class="uf">
            <label for="cMsg">Message</label>
            <textarea
              id="cMsg"
              name="message"
              rows="1"
              placeholder="A project, an idea, or just a hello…"
              required></textarea>
          </div>
          <div class="a-foot">
            <button class="send" id="sendBtn" type="submit"
              >Send message <span class="ar">↗</span></button
            >
          </div>
          <p
            id="helloFeedback"
            aria-live="polite"
            class="cf-sent"
            style="display:none"
          >
          </p>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  import '../scripts/contact-sheet';
</script>
